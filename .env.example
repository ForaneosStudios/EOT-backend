# Copia este archivo como .env si quieres cambiar los valores por defecto.
EOT_DB_NAME=eot
EOT_DB_USER=eot
EOT_DB_PASSWORD=eot_dev_password
EOT_DB_PORT=5433

# Supabase Auth issuer: https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUTH_ISSUER=
# Comma-separated browser origins; leave empty for same-origin clients.
APP_CORS_ALLOWED_ORIGINS=
